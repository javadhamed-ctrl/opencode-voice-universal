{
  "name": "@javadhamed-ctrl/opencode-voice-universal",
  "version": "1.0.0",
  "description": "Universal voice interface for OpenCode with pluggable STT/TTS providers. Supports sherpa-onnx (Shenava Koochik STT + Piper TTS), Whisper, Piper, Edge TTS, ElevenLabs, and more. Features: multi-language, wake word, auto/manual modes, mixed-language synthesis.",
  "keywords": [
    "opencode",
    "voice",
    "speech-to-text",
    "stt",
    "text-to-speech",
    "tts",
    "sherpa-onnx",
    "shenava",
    "piper",
    "whisper",
    "wake-word",
    "multilingual"
  ],
  "license": "MIT",
  "author": "Javad Hamed <javadhamed@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javadhamed-ctrl/opencode-voice-universal.git"
  },
  "files": [
    "index.ts",
    "lib"
  ],
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": {
      "import": "./index.ts"
    },
    "./tui": {
      "import": "./index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "npx oxlint .",
    "fmt": "npx oxfmt --check .",
    "fmt:fix": "npx oxfmt --write .",
    "test": "node --test",
    "check": "npm run lint && npm run fmt",
    "prepack": "npm run build",
    "download:models": "node scripts/download-models.cjs",
    "postinstall": "node scripts/postinstall.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "sherpa-onnx": "^1.10.0",
    "zod": "^3.22.0"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
